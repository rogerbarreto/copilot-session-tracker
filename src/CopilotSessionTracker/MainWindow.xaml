<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CopilotSessionTracker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CopilotSessionTracker.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20,16,20,16" RowSpacing="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Copilot Session Tracker" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Your local Copilot CLI sessions (~/.copilot/session-state)"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{x:Bind ViewModel.RefreshCommand}"
                    AutomationProperties.Name="Refresh sessions">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>

            <ProgressRing Grid.Column="1" Width="20" Height="20"
                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <TextBox Grid.Column="2"
                     PlaceholderText="Search by name, id, working directory or repository…"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Button Grid.Column="4" Click="Settings_Click"
                    AutomationProperties.Name="Settings"
                    ToolTipService.ToolTip="Configure the terminal command">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <TextBlock Text="Settings" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Table header -->
        <Border Grid.Row="2" Padding="12,8,24,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6,6,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SESSION" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="SESSION ID" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="LAST ACTIVITY" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="ACTIONS" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- Rows -->
        <Border Grid.Row="3"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,1,1" CornerRadius="0,0,6,6">
            <ListView x:Name="SessionsList"
                      ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
                      SelectionMode="None"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollMode="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,8,12,8" />
                        <Setter Property="MinHeight" Value="52" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SessionInfo">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="230" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2"
                                        ToolTipService.ToolTip="{x:Bind LocationTooltip}">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind WorkingDirectoryDisplay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>

                            <HyperlinkButton Grid.Column="1" VerticalAlignment="Center"
                                             Click="CopyId_Click" Tag="{x:Bind Id}"
                                             Padding="4,2,4,2"
                                             AutomationProperties.Name="Copy session id"
                                             ToolTipService.ToolTip="Click to copy the full session id to the clipboard">
                                <TextBlock Text="{x:Bind ShortId}" FontFamily="Consolas" />
                            </HyperlinkButton>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       Text="{x:Bind LastActivityDisplay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       ToolTipService.ToolTip="Last conversation interaction" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Click="OpenTerminal_Click" Tag="{x:Bind}"
                                        AutomationProperties.Name="Open terminal"
                                        ToolTipService.ToolTip="Open a standalone terminal and resume this session in yolo mode">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE756;" FontSize="14" />
                                        <TextBlock Text="Terminal" />
                                    </StackPanel>
                                </Button>
                                <Button Click="Peek_Click" Tag="{x:Bind}"
                                        AutomationProperties.Name="Peek"
                                        ToolTipService.ToolTip="Peek at the last conversation turns">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                                        <TextBlock Text="Peek" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="4"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Terminal runs the configured command (Settings) with {id}/{cwd} substituted in a new window." />
    </Grid>
</Window>
